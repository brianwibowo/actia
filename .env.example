# Database PostgreSQL + TimescaleDB
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=ganti_password_db_yang_kuat

# Backend API
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DATABASE_URL=postgresql://telemetry:ganti_password_db_yang_kuat@db:5432/telemetry
JWT_SECRET=ganti_dengan_random_string_minimal_32_karakter
COOKIE_SECURE=true
CORS_ORIGIN=https://namaproject.duckdns.org

# Admin awal (dipakai saat migrasi/seed pertama kali)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti_password_admin

# Domain DuckDNS untuk Caddy HTTPS otomatis
DOMAIN=namaproject.duckdns.org

# Opsional: notifikasi Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional: interval pengecekan node offline dalam detik (default 60)
WORKER_INTERVAL_S=60
